# Supply OPENAI_API_KEY through your host's secret manager, never source control.
OPENAI_TEXT_MODEL=gpt-6.1-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Configurable estimate per million TEXT tokens; verify your OpenAI price sheet.
# This estimate does not include transcription or synthesized speech.
OPENAI_INPUT_USD_PER_MILLION=2
OPENAI_OUTPUT_USD_PER_MILLION=10
PORT=3001
# DATABASE_URL must be provided securely to the server.
