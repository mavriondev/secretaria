{
  "openapi": "3.0.3",
  "info": {
    "title": "Tato — API de envio de dados do cliente",
    "version": "1.0.0",
    "description": "API pública de integração, não toda a API interna do painel. A chave escolhe a empresa; não há empresaId no envio. Catálogo autenticado é a fonte de verdade. Limites: 20.000 linhas/lote e 15 MiB no POST. Carga completa substitui a tabela quando ultimo=true."
  },
  "servers": [
    {
      "url": "https://187.77.232.164/tato/api",
      "description": "VPS oficial"
    }
  ],
  "security": [
    {
      "SendingKey": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "security": [],
        "summary": "Saúde pública do servidor",
        "responses": {
          "200": {
            "description": "Servidor ativo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "versao": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ingestao/estado": {
      "get": {
        "operationId": "sendingState",
        "summary": "Contrato e progresso da empresa",
        "description": "Pode preparar tabelas do espelho. Não gera/revela chave e não libera a IA.",
        "responses": {
          "200": {
            "description": "Contrato da empresa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "401": {
            "description": "Requisição rejeitada; consultar error. Lote não efetivado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Requisição rejeitada; consultar error. Lote não efetivado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Requisição rejeitada; consultar error. Lote não efetivado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/ingestao/tabelas/{tabela}": {
      "post": {
        "operationId": "sendBatch",
        "summary": "Enviar lote de uma tabela",
        "description": "Nome deve fazer parte do contrato. Lote transacional; chave repetida no lote: última linha vence. Incremental substitui a linha inteira, não somente os campos informados. Completa exige carga e usa staging; ultimo=true efetiva substituição da tabela. Não há transação conjunta entre tabelas.",
        "parameters": [
          {
            "name": "tabela",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Nome retornado pelo contrato, sem distinção entre maiúsculas e minúsculas."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Batch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lote aceito; verificar concluida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            }
          },
          "400": {
            "description": "Requisição rejeitada; consultar error. Lote não efetivado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Requisição rejeitada; consultar error. Lote não efetivado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Requisição rejeitada; consultar error. Lote não efetivado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Requisição rejeitada; consultar error. Lote não efetivado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Requisição rejeitada; consultar error. Lote não efetivado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Requisição rejeitada; consultar error. Lote não efetivado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Requisição rejeitada; consultar error. Lote não efetivado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SendingKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Chave tato_env_… exclusiva da empresa, emitida pelo dono. Não é senha, sessão do painel ou token de outro serviço."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Column": {
        "type": "object",
        "required": [
          "nome",
          "tipo"
        ],
        "properties": {
          "nome": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          }
        }
      },
      "Table": {
        "type": "object",
        "properties": {
          "tabela": {
            "type": "string"
          },
          "chave": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "colunaDeAlteracao": {
            "type": "string",
            "nullable": true
          },
          "colunas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Column"
            }
          },
          "linhas": {
            "type": "integer"
          },
          "ultimaMarca": {
            "type": "string",
            "nullable": true
          },
          "recebidoEm": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "State": {
        "type": "object",
        "properties": {
          "limitePorLote": {
            "type": "integer",
            "example": 20000
          },
          "tabelas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Table"
            }
          }
        }
      },
      "Batch": {
        "type": "object",
        "required": [
          "linhas"
        ],
        "properties": {
          "modo": {
            "type": "string",
            "enum": [
              "incremental",
              "completa"
            ],
            "default": "incremental"
          },
          "carga": {
            "type": "string",
            "maxLength": 64,
            "description": "Obrigatória em completa: ^[A-Za-z0-9_-]{4,64}$, ID consistente nos lotes de uma tabela/carga."
          },
          "ultimo": {
            "type": "boolean",
            "description": "Em completa, true efetiva a substituição. Em incremental, não altera o comportamento."
          },
          "linhas": {
            "type": "array",
            "maxItems": 20000,
            "items": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "nullable": true
                  },
                  {
                    "type": "number",
                    "nullable": true
                  },
                  {
                    "type": "boolean",
                    "nullable": true
                  }
                ]
              }
            },
            "description": "Colunas do contrato; chaves não podem ser nulas. Objetos/arrays como valores são rejeitados. Campos omitidos viram null."
          }
        }
      },
      "BatchResult": {
        "type": "object",
        "required": [
          "ok",
          "tabela",
          "modo",
          "recebidas",
          "gravadas",
          "concluida"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "tabela": {
            "type": "string"
          },
          "modo": {
            "type": "string",
            "enum": [
              "incremental",
              "completa"
            ]
          },
          "recebidas": {
            "type": "integer"
          },
          "gravadas": {
            "type": "integer"
          },
          "concluida": {
            "type": "boolean"
          },
          "colunasIgnoradas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
